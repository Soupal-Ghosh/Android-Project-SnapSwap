<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cat_base">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cat_mantle"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_undo"
            app:navigationIconTint="@color/cat_text"
            app:title="Crop Image"
            app:titleTextColor="@color/cat_text" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.canhub.cropper.CropImageView
        android:id="@+id/cropImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsBar"
        app:layout_constraintTop_toBottomOf="@id/appBar" />

    <ImageView
        android:id="@+id/previewImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/cat_base"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Cropped preview"
        app:layout_constraintBottom_toTopOf="@id/bottomActionsBar"
        app:layout_constraintTop_toBottomOf="@id/appBar" />

    <LinearLayout
        android:id="@+id/bottomActionsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cat_mantle"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrop"
            style="@style/Widget.Snapy.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Apply Crop"
            android:layout_marginEnd="8dp"
            app:backgroundTint="@color/lavender_pink"
            android:textColor="@color/cat_base" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Snapy.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Save Image"
            android:layout_marginStart="8dp"
            android:enabled="false"
            app:backgroundTint="@color/cat_peach"
            android:textColor="@color/cat_base" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
