<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cat_base">

    <!-- Onboarding (Soft Lavender) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/onboardingContainer"
        style="@style/Widget.Snapy.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Flick through the roll."
                android:textColor="@color/cat_text"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/line2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="RIGHT to Keep\nLEFT to Discard"
                android:textColor="@color/cat_lavender"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/line3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Archive: Kept for memories"
                android:textColor="@color/cat_subtext1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/line4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bin: Into the dark"
                android:textColor="@color/cat_subtext1"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/cat_lavender"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fabContainer"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_photo" />

    <!-- Actions (Cozy Glass Bar) -->
    <LinearLayout
        android:id="@+id/fabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDislikedPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:contentDescription="Review Bin"
            android:src="@drawable/ic_dislike"
            app:backgroundTint="@color/cat_surface0"
            app:fabSize="mini"
            app:tint="@color/cat_rosewater" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Add to Roll"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/lavender_pink"
            app:fabSize="normal"
            app:tint="@color/cat_base" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLikedPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:contentDescription="Review Archive"
            android:src="@drawable/ic_like"
            app:backgroundTint="@color/cat_surface0"
            app:fabSize="mini"
            app:tint="@color/lavender_pink" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
