<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/cat_overlay1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Add to Album"
        android:textColor="@color/cat_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolders"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:paddingBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateNewFolder"
        style="@style/Widget.Snapy.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Create New Album"
        android:textSize="14sp"
        app:backgroundTint="@color/cat_surface0"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconTint="@color/lavender_pink" />

</LinearLayout>
